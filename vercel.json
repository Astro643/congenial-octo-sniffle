{
  "functions": {
    "api/site.ts": {
      "includeFiles": "{app/**,public/**,node_modules/remix/**,node_modules/framer-motion/**,node_modules/@tsparticles/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://special-octo-discouvicorn-main-app-host.onrender.com/api/:path*" },
    { "source": "/login", "destination": "https://special-octo-discouvicorn-main-app-host.onrender.com/login" },
    { "source": "/((?!api/|login).*)", "destination": "/api/site" }
  ]
}
