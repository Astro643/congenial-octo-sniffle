# Frontend server only. Never prefix AGENT_API_KEY with NEXT_PUBLIC_ or expose it to browser code.
AGENT_BACKEND_URL=https://didactic-doodle-three.vercel.app
AGENT_API_KEY=

# Localhost-only testing bypass; works only with NODE_ENV=development and a loopback host.
# Keep false in every deployed environment. Production requests fail closed until the existing
# signed-session verifier is connected to the agent proxy routes.
AGENT_PROXY_TEST_MODE=false
